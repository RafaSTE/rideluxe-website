{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "rideluxe-website.vercel.app" }],
      "destination": "https://rideluxe.mx/$1",
      "permanent": true
    },
    { "source": "/cancun-transfers", "destination": "/cancun-airport-transfers", "permanent": true },
    { "source": "/tulum-transfers", "destination": "/tulum-airport-transfers", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
